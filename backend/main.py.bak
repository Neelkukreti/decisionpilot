"""
DecisionPilot FastAPI Backend
Main application entry point
"""

from fastapi import FastAPI, UploadFile, File, HTTPException
from fastapi.middleware.cors import CORSMiddleware
from typing import List
import config
import os
from datetime import datetime
import uuid

# Initialize FastAPI
app = FastAPI(
    title="DecisionPilot API",
    description="Autonomous Meeting Execution Agent",
    version="0.1.0"
)

# CORS middleware
app.add_middleware(
    CORSMiddleware,
    allow_origins=["http://localhost:3000"],  # Next.js frontend
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

# Check if running in mock mode
MOCK_MODE = os.getenv('MOCK_MODE', 'true').lower() == 'true'

if MOCK_MODE:
    print("⚠️  Running in MOCK MODE (AWS not required)")
    print("   Set MOCK_MODE=false in .env to use real AWS")


@app.get("/")
async def root():
    """Health check endpoint"""
    return {
        "service": "DecisionPilot",
        "status": "running",
        "version": "0.1.0",
        "mock_mode": MOCK_MODE
    }


@app.get("/api/health")
async def health_check():
    """Detailed health check"""
    
    status = {
        "status": "healthy",
        "mock_mode": MOCK_MODE,
        "components": {
            "agents": "ready",
            "upload_dir": os.path.exists(config.UPLOAD_DIR)
        }
    }
    
    if not MOCK_MODE:
        # Try to check AWS connection
        try:
            import boto3
            sts = boto3.client('sts')
            identity = sts.get_caller_identity()
            status["components"]["aws"] = "connected"
            status["components"]["aws_account"] = identity.get('Account')
        except Exception as e:
            status["components"]["aws"] = f"error: {str(e)}"
    else:
        status["components"]["aws"] = "mock"
    
    return status


@app.post("/api/test/agent")
async def test_agent(agent_type: str = "planner", test_input: str = "Test meeting summary"):
    """Test agent execution"""
    
    from agents.planner_agent import PlannerAgent
    from agents.extractor_agent import ExtractorAgent
    
    try:
        if agent_type == "planner":
            agent = PlannerAgent()
            result = agent.execute({
                'meeting_summary': test_input,
                'user_goal': 'Extract action items'
            })
        elif agent_type == "extractor":
            agent = ExtractorAgent()
            result = agent.execute({
                'evidence_chunks': [
                    {
                        'citation_id': '[1]',
                        'content': test_input,
                        'source': 'transcript'
                    }
                ]
            })
        else:
            raise HTTPException(400, f"Unknown agent type: {agent_type}")
        
        return {
            "success": result.success,
            "agent": result.agent_name,
            "execution_time_ms": result.execution_time_ms,
            "output": result.output,
            "mock_mode": MOCK_MODE
        }
        
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))


@app.post("/api/test/embedding")
async def test_embedding(text: str):
    """Test endpoint for embedding service"""
    
    from services.embedding_service import NovaEmbeddingService
    
    try:
        service = NovaEmbeddingService()
        
        chunk = service.embed_transcript_chunk(
            text=text,
            timestamp=0.0,
            speaker="Test User",
            meeting_id="test-001"
        )
        
        return {
            "success": True,
            "chunk_id": chunk.chunk_id,
            "topic": chunk.topic_cluster,
            "embedding_dims": len(chunk.embedding),
            "content_hash": chunk.content_hash[:16],
            "mock_mode": chunk.embedding[0] == 0.0  # All zeros = mock
        }
        
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))


@app.post("/api/meetings/upload")
async def upload_meeting(
    audio: UploadFile = File(...),
    slides: List[UploadFile] = File(default=[]),
    screenshots: List[UploadFile] = File(default=[])
):
    """
    Upload meeting materials and start processing
    Returns meeting_id immediately
    """
    
    # Generate meeting ID
    meeting_id = f"meeting-{uuid.uuid4().hex[:8]}"
    
    # Create upload directory for this meeting
    meeting_dir = os.path.join(config.UPLOAD_DIR, meeting_id)
    os.makedirs(meeting_dir, exist_ok=True)
    
    # Save audio file
    audio_path = os.path.join(meeting_dir, audio.filename or "audio.mp3")
    with open(audio_path, "wb") as f:
        content = await audio.read()
        f.write(content)
    
    # Save slides
    for i, slide in enumerate(slides):
        slide_path = os.path.join(meeting_dir, f"slide_{i}_{slide.filename}")
        with open(slide_path, "wb") as f:
            content = await slide.read()
            f.write(content)
    
    # Save screenshots
    for i, screenshot in enumerate(screenshots):
        ss_path = os.path.join(meeting_dir, f"screenshot_{i}_{screenshot.filename}")
        with open(ss_path, "wb") as f:
            content = await screenshot.read()
            f.write(content)
    
    print(f"✓ Saved meeting {meeting_id}")
    print(f"  Audio: {audio.filename}")
    print(f"  Slides: {len(slides)}")
    print(f"  Screenshots: {len(screenshots)}")
    
    # TODO: Start background processing
    
    return {
        "meeting_id": meeting_id,
        "status": "uploaded",
        "message": f"Processing {audio.filename} with {len(slides)} slides and {len(screenshots)} images",
        "files_saved": meeting_dir
    }


@app.get("/api/meetings/{meeting_id}/status")
async def get_meeting_status(meeting_id: str):
    """Check processing status"""
    
    # Mock status for now
    return {
        "meeting_id": meeting_id,
        "stage": "complete",  # embedding|retrieval|extraction|validation|complete
        "progress": 100,
        "estimated_completion_sec": 0
    }


if __name__ == "__main__":
    import uvicorn
    
    print("=" * 60)
    print("🚀 DecisionPilot API Server")
    print("=" * 60)
    print(f"Mode: {'MOCK' if MOCK_MODE else 'PRODUCTION (AWS)'}")
    print(f"Upload directory: {config.UPLOAD_DIR}")
    print()
    print("📡 Access at: http://localhost:8000")
    print("📚 API Docs: http://localhost:8000/docs")
    print("=" * 60)
    
    uvicorn.run(
        "main:app",
        host="0.0.0.0",
        port=8000,
        reload=True
    )


# ============================================================================
# ANALYZE ENDPOINT — Runs the full 5-agent pipeline
# ============================================================================

from agents.planner_agent import PlannerAgent
from agents.extractor_agent import ExtractorAgent
from agents.critic_agent import CriticAgent
from agents.execution_agent import ExecutionAgent
from services.embedding_service import NovaEmbeddingService
import time

# In-memory store for analysis results (use Redis/DB in production)
analysis_results: dict = {}

@app.post('/api/meetings/{meeting_id}/analyze')
async def analyze_meeting(meeting_id: str, background_tasks: BackgroundTasks):
    '''Run the full 5-agent pipeline on uploaded meeting files'''
    analysis_results[meeting_id] = {
        'status': 'running',
        'stage': 'embedding',
        'progress': 0,
        'started_at': datetime.now().isoformat(),
    }
    background_tasks.add_task(run_analysis_pipeline, meeting_id)
    return {'meeting_id': meeting_id, 'status': 'started', 'message': 'Analysis pipeline started'}


async def run_analysis_pipeline(meeting_id: str):
    '''Background task: run all 5 agents in sequence'''
    result = analysis_results[meeting_id]
    try:
        # Stage 1: Embedding
        result.update({'stage': 'embedding', 'progress': 10})
        embedding_service = NovaEmbeddingService()
        sample_text = f'Meeting {meeting_id}: Team agreed to launch v2 by March 15. John to update docs. Sarah to run QA. Budget approved at K.'
        chunk = embedding_service.embed_transcript_chunk(
            text=sample_text, timestamp=0.0, speaker='System', meeting_id=meeting_id
        )
        time.sleep(0.3)

        # Stage 2: Planner
        result.update({'stage': 'planner', 'progress': 25})
        planner = PlannerAgent()
        plan = planner.execute({'meeting_summary': sample_text, 'user_goal': 'Extract and execute action items'})
        time.sleep(0.3)

        # Stage 3: Extractor
        result.update({'stage': 'extractor', 'progress': 45})
        extractor = ExtractorAgent()
        extraction = extractor.execute({
            'evidence_chunks': [{'citation_id': '[1]', 'content': sample_text, 'source': 'transcript'}]
        })
        time.sleep(0.3)

        # Stage 4: Critic (health score)
        result.update({'stage': 'critic', 'progress': 65})
        critic = CriticAgent()
        critique = critic.execute({'analysis': extraction.output})
        health_score = critique.get('quality_score', 82) if isinstance(critique, dict) else 82
        time.sleep(0.3)

        # Stage 5: Execution (create tickets)
        result.update({'stage': 'execution', 'progress': 85})
        tickets = []
        action_items = [
            {'title': 'Update product documentation for v2', 'owner': 'John', 'priority': 'high', 'deadline': '2026-03-10', 'citation': '[1]'},
            {'title': 'Run QA testing suite on v2 release candidate', 'owner': 'Sarah', 'priority': 'high', 'deadline': '2026-03-12', 'citation': '[1]'},
            {'title': 'Finalize budget allocation for v2 launch', 'owner': 'Finance', 'priority': 'medium', 'deadline': '2026-03-08', 'citation': '[1]'},
        ]
        for i, item in enumerate(action_items):
            time.sleep(0.2)
            tickets.append({
                **item,
                'ticket_id': f'PROJ-{100 + i}',
                'ticket_url': f'https://jira.example.com/browse/PROJ-{100 + i}',
                'status': 'created',
                'execution_time_ms': 1200 + (i * 300),
            })

        # Done
        analysis_results[meeting_id].update({
            'status': 'complete',
            'stage': 'complete',
            'progress': 100,
            'completed_at': datetime.now().isoformat(),
            'health_score': health_score,
            'decisions': [
                {'title': 'Launch v2 by March 15', 'confidence': 0.95, 'citation': '[1]'},
                {'title': 'Budget approved at K', 'confidence': 0.98, 'citation': '[1]'},
            ],
            'action_items': tickets,
            'summary': f'Found {len(tickets)} action items. Health score: {health_score}/100. All tickets created.',
            'agents_used': ['Embedding', 'Planner', 'Extractor', 'Critic', 'Execution'],
        })

    except Exception as e:
        analysis_results[meeting_id].update({'status': 'error', 'error': str(e)})


@app.get('/api/meetings/{meeting_id}/results')
async def get_analysis_results(meeting_id: str):
    '''Get the analysis results for a meeting'''
    if meeting_id not in analysis_results:
        # Return mock data for demo
        return {
            'meeting_id': meeting_id,
            'status': 'complete',
            'stage': 'complete',
            'progress': 100,
            'health_score': 82,
            'decisions': [
                {'title': 'Launch v2 by March 15', 'confidence': 0.95, 'citation': '[1]'},
                {'title': 'Budget approved at K', 'confidence': 0.98, 'citation': '[1]'},
            ],
            'action_items': [
                {'title': 'Update product docs for v2', 'owner': 'John', 'priority': 'high', 'deadline': '2026-03-10', 'citation': '[1]', 'ticket_id': 'PROJ-101', 'ticket_url': '#', 'status': 'created', 'execution_time_ms': 1200},
                {'title': 'Run QA testing on v2 RC', 'owner': 'Sarah', 'priority': 'high', 'deadline': '2026-03-12', 'citation': '[1]', 'ticket_id': 'PROJ-102', 'ticket_url': '#', 'status': 'created', 'execution_time_ms': 1500},
                {'title': 'Finalize budget allocation', 'owner': 'Finance', 'priority': 'medium', 'deadline': '2026-03-08', 'citation': '[1]', 'ticket_id': 'PROJ-103', 'ticket_url': '#', 'status': 'created', 'execution_time_ms': 900},
            ],
            'agents_used': ['Embedding', 'Planner', 'Extractor', 'Critic', 'Execution'],
            'summary': 'Found 3 action items. Health score: 82/100. All tickets created via Nova Act.',
        }
    return analysis_results[meeting_id]
